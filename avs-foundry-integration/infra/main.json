{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.36.177.2456",
      "templateHash": "6037355194695077363"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "avsai",
      "metadata": {
        "description": "Short prefix used to name the resources."
      }
    },
    "existingVnetName": {
      "type": "string",
      "metadata": {
        "description": "Name of the EXISTING VNet that can route to your AVS private cloud (Gen 1: a VNet with ExpressRoute connectivity; Gen 2: the private cloud's own VNet, or one peered to it)."
      }
    },
    "acaSubnetName": {
      "type": "string",
      "defaultValue": "aca-subnet",
      "metadata": {
        "description": "Name of the delegated subnet to create for Container Apps."
      }
    },
    "createAcaSubnet": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Create the delegated Container Apps subnet. Set to FALSE when you already created it with connectivity.bicep, which also creates a subnet named \"aca-subnet\" -- otherwise this template re-writes that subnet and a mismatched acaSubnetPrefix will silently reconfigure or fail it."
      }
    },
    "acaSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.40.8.0/23",
      "metadata": {
        "description": "Address prefix for the delegated Container Apps subnet (must fit inside the existing VNet and be at least /23)."
      }
    },
    "sqlUser": {
      "type": "string",
      "defaultValue": "agentreader",
      "metadata": {
        "description": "Read-only SQL login the agent uses to query your databases."
      }
    },
    "sqlPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Password for the read-only SQL login. Stored as a Key Vault secret."
      }
    },
    "containerImage": {
      "type": "string",
      "defaultValue": "mcr.microsoft.com/azuredocs/containerapps-helloworld:latest",
      "metadata": {
        "description": "Container image for the MCP server. Defaults to a public placeholder; swap to your ACR image after you build + push it."
      }
    },
    "tenantId": {
      "type": "string",
      "defaultValue": "[subscription().tenantId]",
      "metadata": {
        "description": "Microsoft Entra tenant ID used for in-app token validation."
      }
    },
    "allowedAudiences": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Allowed audiences (comma-separated) for in-app token validation. Set to your MCP app-registration audience."
      }
    },
    "allowedCallers": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Allowed caller app IDs / azp (comma-separated). Set to your Foundry project managed identity after the agent exists."
      }
    },
    "deployFoundry": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Also deploy an Azure AI Foundry (AIServices) account + project + model deployment."
      }
    },
    "foundryProjectName": {
      "type": "string",
      "defaultValue": "[format('{0}-project', parameters('namePrefix'))]",
      "metadata": {
        "description": "Name of the Foundry project that will host the agent. Its managed identity is the caller you put in allowedCallers."
      }
    },
    "foundryLocation": {
      "type": "string",
      "defaultValue": "[parameters('location')]",
      "metadata": {
        "description": "Location for the Foundry account. Defaults to the main location, but the agent reaches the MCP server over public HTTPS, so Foundry can live in a model-rich region when the AVS region has no GPT models (e.g. westus2)."
      }
    },
    "modelName": {
      "type": "string",
      "defaultValue": "gpt-5.4-mini",
      "metadata": {
        "description": "Model to deploy in Foundry (only used when deployFoundry = true). Model availability AND lifecycle vary by region: a model in a \"Deprecating\" state is rejected for new deployments. Check `az cognitiveservices model list -l <foundryLocation>` before deploying."
      }
    },
    "modelVersion": {
      "type": "string",
      "defaultValue": "2026-03-17",
      "metadata": {
        "description": "Version of the model to deploy."
      }
    },
    "discoveryMode": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Temporarily allow any validly-authenticated Entra caller so you can read the caller azp from the logs and then populate allowedCallers. Never leave this on: it disables the caller allow-list (it does NOT disable token validation)."
      }
    }
  },
  "variables": {
    "kvName": "[take(format('{0}-kv-{1}', parameters('namePrefix'), uniqueString(resourceGroup().id)), 24)]",
    "acrName": "[format('{0}acr{1}', parameters('namePrefix'), uniqueString(resourceGroup().id))]",
    "envName": "[format('{0}-mcp-env', parameters('namePrefix'))]",
    "appName": "[format('{0}-mcp-server', parameters('namePrefix'))]",
    "foundryName": "[format('{0}-foundry-{1}', parameters('namePrefix'), uniqueString(resourceGroup().id))]",
    "secretName": "sql-agentreader-password",
    "kvSecretsUserRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]",
    "acrPullRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]",
    "acaSubnetId": "[format('{0}/subnets/{1}', resourceId('Microsoft.Network/virtualNetworks', parameters('existingVnetName')), parameters('acaSubnetName'))]"
  },
  "resources": [
    {
      "condition": "[parameters('createAcaSubnet')]",
      "type": "Microsoft.Network/virtualNetworks/subnets",
      "apiVersion": "2023-11-01",
      "name": "[format('{0}/{1}', parameters('existingVnetName'), parameters('acaSubnetName'))]",
      "properties": {
        "addressPrefix": "[parameters('acaSubnetPrefix')]",
        "delegations": [
          {
            "name": "aca-delegation",
            "properties": {
              "serviceName": "Microsoft.App/environments"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('{0}-mcp-identity', parameters('namePrefix'))]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[variables('acrName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "adminUserEnabled": false
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('kvName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[parameters('tenantId')]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('kvName'), variables('secretName'))]",
      "properties": {
        "value": "[parameters('sqlPassword')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('kvName'))]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}-logs', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[variables('envName')]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix'))), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix'))), '2023-09-01').primarySharedKey]"
          }
        },
        "vnetConfiguration": {
          "infrastructureSubnetId": "[variables('acaSubnetId')]",
          "internal": false
        },
        "workloadProfiles": [
          {
            "name": "Consumption",
            "workloadProfileType": "Consumption"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('existingVnetName'), parameters('acaSubnetName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mcp-identity', parameters('namePrefix'))))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 8000,
            "transport": "auto"
          },
          "registries": [
            {
              "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mcp-identity', parameters('namePrefix')))]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "mcp",
              "image": "[parameters('containerImage')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "KEY_VAULT_URL",
                  "value": "[reference(resourceId('Microsoft.KeyVault/vaults', variables('kvName')), '2023-07-01').vaultUri]"
                },
                {
                  "name": "SQL_USER",
                  "value": "[parameters('sqlUser')]"
                },
                {
                  "name": "HOST",
                  "value": "0.0.0.0"
                },
                {
                  "name": "PORT",
                  "value": "8000"
                },
                {
                  "name": "TENANT_ID",
                  "value": "[parameters('tenantId')]"
                },
                {
                  "name": "ALLOWED_AUDIENCES",
                  "value": "[parameters('allowedAudiences')]"
                },
                {
                  "name": "ALLOWED_CALLERS",
                  "value": "[parameters('allowedCallers')]"
                },
                {
                  "name": "DISCOVERY_MODE",
                  "value": "[string(parameters('discoveryMode'))]"
                },
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mcp-identity', parameters('namePrefix'))), '2023-01-31').clientId]"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 3
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]",
        "[extensionResourceId(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mcp-identity', parameters('namePrefix'))), variables('acrPullRoleId')))]",
        "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "[resourceId('Microsoft.KeyVault/vaults', variables('kvName'))]",
        "[extensionResourceId(resourceId('Microsoft.KeyVault/vaults', variables('kvName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.KeyVault/vaults', variables('kvName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mcp-identity', parameters('namePrefix'))), variables('kvSecretsUserRoleId')))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mcp-identity', parameters('namePrefix')))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[format('Microsoft.KeyVault/vaults/{0}', variables('kvName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('kvName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mcp-identity', parameters('namePrefix'))), variables('kvSecretsUserRoleId'))]",
      "properties": {
        "roleDefinitionId": "[variables('kvSecretsUserRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mcp-identity', parameters('namePrefix'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('kvName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mcp-identity', parameters('namePrefix')))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[format('Microsoft.ContainerRegistry/registries/{0}', variables('acrName'))]",
      "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mcp-identity', parameters('namePrefix'))), variables('acrPullRoleId'))]",
      "properties": {
        "roleDefinitionId": "[variables('acrPullRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mcp-identity', parameters('namePrefix'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mcp-identity', parameters('namePrefix')))]"
      ]
    },
    {
      "condition": "[parameters('deployFoundry')]",
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2025-06-01",
      "name": "[variables('foundryName')]",
      "location": "[parameters('foundryLocation')]",
      "kind": "AIServices",
      "sku": {
        "name": "S0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "allowProjectManagement": true,
        "customSubDomainName": "[toLower(variables('foundryName'))]",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "condition": "[parameters('deployFoundry')]",
      "type": "Microsoft.CognitiveServices/accounts/projects",
      "apiVersion": "2025-06-01",
      "name": "[format('{0}/{1}', variables('foundryName'), parameters('foundryProjectName'))]",
      "location": "[parameters('foundryLocation')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "displayName": "[parameters('foundryProjectName')]",
        "description": "Agents that query private databases inside AVS via the MCP server."
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName'))]"
      ]
    },
    {
      "condition": "[parameters('deployFoundry')]",
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2025-06-01",
      "name": "[format('{0}/{1}', variables('foundryName'), parameters('modelName'))]",
      "sku": {
        "name": "GlobalStandard",
        "capacity": 50
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[parameters('modelName')]",
          "version": "[parameters('modelVersion')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName'))]"
      ]
    }
  ],
  "outputs": {
    "acrName": {
      "type": "string",
      "value": "[variables('acrName')]"
    },
    "acrLoginServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer]"
    },
    "mcpFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', variables('appName')), '2024-03-01').configuration.ingress.fqdn]"
    },
    "mcpEndpoint": {
      "type": "string",
      "value": "[format('https://{0}/mcp', reference(resourceId('Microsoft.App/containerApps', variables('appName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', variables('kvName')), '2023-07-01').vaultUri]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[variables('kvName')]"
    },
    "appPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mcp-identity', parameters('namePrefix'))), '2023-01-31').principalId]"
    },
    "appClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mcp-identity', parameters('namePrefix'))), '2023-01-31').clientId]"
    },
    "foundryEndpoint": {
      "type": "string",
      "value": "[if(parameters('deployFoundry'), reference(resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName')), '2025-06-01').endpoint, '')]"
    },
    "foundryProjectEndpoint": {
      "type": "string",
      "value": "[if(parameters('deployFoundry'), format('https://{0}.services.ai.azure.com/api/projects/{1}', toLower(variables('foundryName')), parameters('foundryProjectName')), '')]"
    },
    "foundryAccountId": {
      "type": "string",
      "value": "[if(parameters('deployFoundry'), resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName')), '')]"
    },
    "foundryProjectPrincipalId": {
      "type": "string",
      "value": "[if(parameters('deployFoundry'), reference(resourceId('Microsoft.CognitiveServices/accounts/projects', variables('foundryName'), parameters('foundryProjectName')), '2025-06-01', 'full').identity.principalId, '')]"
    }
  }
}